{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

    "formatter": {
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 90
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    },

    "linter":{
        "enabled": true,
        "rules": {
            "recommended": true
        }
    }
}